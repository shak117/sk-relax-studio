# =============================================================================
# SK RELAX BEAUTY ACADEMY & SALON — ENVIRONMENT CONFIGURATION
# =============================================================================

# Production Site URL (Used for Canonical URLs, Open Graph, Sitemap & Schema.org)
# Replace with the final verified domain when supplied by the client
VITE_SITE_URL=https://skrelaxbeauty.com

# Meta (Facebook / Instagram) Pixel Dataset ID
# Obtain this from Meta Events Manager -> Data Sources -> Dataset ID
# Example: VITE_META_PIXEL_ID=123456789012345
# Leave blank or unconfigured until client confirms access; site remains 100% functional.
VITE_META_PIXEL_ID=

# Google Search Console Verification Token (Optional HTML meta tag verification)
# Example: VITE_GSC_VERIFICATION_TOKEN=your_google_verification_code_here
VITE_GSC_VERIFICATION_TOKEN=

# Require Cookie / Tracking Consent before initializing Meta Pixel (true/false)
VITE_REQUIRE_CONSENT=true
